doctype html
html lang="en"
  head
    title = content_for?(:title) ? yield(:title) : "Admin — Vincent"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="robots" content="noindex,nofollow"
    = csrf_meta_tags
    = csp_meta_tag

    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""
    link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&display=swap"

    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  body class="min-h-dvh bg-canvas text-ink antialiased"
    header class="border-b border-line/60"
      div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-5 sm:px-10 lg:px-16"
        p class="font-mono text-xs uppercase tracking-[0.28em] text-ink-muted"
          | Admin
        nav class="flex items-center gap-6 font-mono text-xs uppercase tracking-[0.22em]"
          = link_to "Projects", admin_projects_path, class: "text-ink-muted transition hover:text-accent"
          = link_to "Posts",    admin_posts_path,    class: "text-ink-muted transition hover:text-accent"
          = link_to "Site ↗",   root_path,           class: "text-ink-muted transition hover:text-accent"

    - if notice
      div class="border-b border-line/60 bg-accent-soft"
        p class="mx-auto max-w-5xl px-6 py-3 font-mono text-xs uppercase tracking-[0.22em] text-accent sm:px-10 lg:px-16"
          = notice

    main class="mx-auto w-full max-w-5xl px-6 pb-24 pt-12 sm:px-10 lg:px-16"
      = yield
