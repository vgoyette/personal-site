- content_for :title, "#{@post.title} — Admin"

header class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between"
  div
    p class="font-mono text-xs uppercase tracking-[0.22em] text-ink-muted"
      = link_to "← Posts", admin_posts_path, class: "transition hover:text-accent"
    h1 class="mt-4 font-display text-3xl font-medium tracking-tight text-ink"
      = @post.title
    p class="mt-2 font-mono text-xs uppercase tracking-[0.22em] text-ink-muted"
      span[class=(@post.published? ? "text-accent" : "text-ink-muted")]
        = @post.published? ? "Published" : "Draft"
      | · #{@post.slug}
      - if @post.published_at
        | · #{l(@post.published_at, format: :long)}
  div class="flex items-center gap-4 font-mono text-xs uppercase tracking-[0.22em]"
    = link_to "Edit", edit_admin_post_path(@post), class: "text-ink-muted transition hover:text-accent"
    - if @post.published?
      = link_to "View ↗", post_path(@post), class: "text-ink-muted transition hover:text-accent", target: "_blank", rel: "noopener"

- if @post.summary.present?
  p class="mt-10 font-sans text-lg leading-relaxed text-ink-muted"
    = @post.summary

div class="mt-10"
  = render Content::MarkdownComponent.new(body: @post.body_markdown)
