- content_for :title, "#{@project.title} — Vincent"

div class="relative isolate min-h-dvh bg-canvas text-ink"
  = render Site::NavComponent.new(current: "projects")

  article class="relative px-6 pb-24 pt-16 sm:px-10 lg:px-16"
    div class="mx-auto w-full max-w-3xl"
      p class="font-mono text-xs uppercase tracking-[0.28em] text-ink-muted"
        = link_to "← All projects", projects_path, class: "transition hover:text-accent"

      header class="mt-10"
        h1 class="font-display text-4xl font-medium leading-tight tracking-tight text-ink sm:text-5xl"
          = @project.title
        div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs uppercase tracking-[0.22em] text-ink-muted"
          - if @project.published_at
            time datetime=@project.published_at.iso8601
              = @project.published_at.strftime("%b %Y")
          - if @project.url.present?
            = link_to "Visit ↗", @project.url, class: "text-accent transition hover:brightness-110", target: "_blank", rel: "noopener"
        - if @project.summary.present?
          p class="mt-6 font-sans text-lg leading-relaxed text-ink-muted"
            = @project.summary

      div class="mt-12"
        = render Content::MarkdownComponent.new(body: @project.body_markdown)
