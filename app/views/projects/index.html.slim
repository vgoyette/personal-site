- content_for :title, "Projects — Vincent"

div class="relative isolate min-h-dvh bg-canvas text-ink"
  = render Site::NavComponent.new(current: "projects")

  section class="relative px-6 pb-24 pt-16 sm:px-10 lg:px-16"
    div class="mx-auto w-full max-w-5xl"
      header class="max-w-3xl"
        p class="font-mono text-xs uppercase tracking-[0.28em] text-ink-muted"
          | Projects
        h1 class="mt-6 font-display text-5xl font-medium leading-[0.95] tracking-tight text-ink sm:text-6xl"
          | Things I've built.
        p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-ink-muted"
          | A short list of work I keep coming back to — some shipped, some in progress, all in the same voice as the rest of this site.

      - if @projects.any?
        ul class="mt-16 divide-y divide-line/60"
          - @projects.each do |project|
            li class="group py-8"
              = link_to project_path(project), class: "block focus-visible:outline-none"
                div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between"
                  h2 class="font-display text-2xl font-medium tracking-tight text-ink transition duration-200 group-hover:text-accent sm:text-3xl"
                    = project.title
                  - if project.published_at
                    time datetime=project.published_at.iso8601 class="font-mono text-xs uppercase tracking-[0.22em] text-ink-muted"
                      = project.published_at.strftime("%b %Y")
                - if project.summary.present?
                  p class="mt-3 max-w-2xl font-sans text-base leading-relaxed text-ink-muted"
                    = project.summary
      - else
        p class="mt-16 font-sans text-base text-ink-muted"
          | Nothing published yet. Check back soon.
